# ── API Keys ──────────────────────────────────────────────────────────────────
# VirusTotal API Key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API Key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Shodan API Key (https://account.shodan.io/) — optional, falls back to InternetDB
SHODAN_API_KEY=

# GreyNoise API Key (https://viz.greynoise.io/account) — optional, free Community API used if empty
GREYNOISE_API_KEY=

# AlienVault OTX API Key (https://otx.alienvault.com/api) — optional, free tier works
ALIENVAULT_API_KEY=

# ── Settings ──────────────────────────────────────────────────────────────────
# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL=86400

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum concurrent enrichment tasks
MAX_CONCURRENCY=5

# HTTP request timeout in seconds
HTTP_TIMEOUT=30

# ── Docker ────────────────────────────────────────────────────────────────────
# Host and port for the uvicorn server (Docker only)
HOST=0.0.0.0
PORT=8000

