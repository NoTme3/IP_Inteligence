{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/(.*\\.(html|css|js|ico|png|svg))", "dest": "public/$1" },
    { "src": "/", "dest": "public/index.html" }
  ]
}
